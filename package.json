{
  "name": "node-webhooks",
  "version": "1.5.0",
  "description": "Create and trigger your own webHooks",
  "main": "index.js",
  "scripts": {
    "test": "standard && nyc --reporter=lcov --reporter=text mocha --timeout=5000 test/**/*.js",
    "std": "standard",
    "coverage": "nyc --reporter=lcov --reporter=text mocha --timeout=5000 test/**/*.js",
    "publish-coverage": "cat ./coverage/lcov.info | coveralls"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roccomuso/node-webhooks.git"
  },
  "keywords": [
    "webhooks",
    "trigger",
    "web",
    "hooks"
  ],
  "author": "Rocco Musolino <roccomusolino92@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/roccomuso/node-webhooks/issues"
  },
  "homepage": "https://github.com/roccomuso/node-webhooks#readme",
  "dependencies": {
    "debug": "^4.4.3",
    "eventemitter2": "^6.4.9",
    "jsonfile": "^6.2.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "coveralls": "^3.1.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "standard": "^17.1.2"
  },
  "standard": {
    "env": [
      "mocha"
    ]
  }
}
